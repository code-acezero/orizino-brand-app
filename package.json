{
  "name": "orizino-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx --yes concurrently -n \"brandhome,storefront,masterpanel,orderops,explore\" -c \"cyan,green,yellow,magenta,blue\" \"npm run dev:brandhome\" \"npm run dev:storefront\" \"npm run dev:masterpanel\" \"npm run dev:orderops\" \"npm run dev:explore\"",
    "dev:brandhome": "npm run dev --prefix apps/brandhome",
    "dev:storefront": "npm run dev --prefix apps/storefront",
    "dev:masterpanel": "npm run dev --prefix apps/masterpanel",
    "dev:orderops": "npm run dev --prefix apps/orderops",
    "dev:explore": "npm run dev --prefix apps/explore",
    "build:brandhome": "npm run build --prefix apps/brandhome",
    "build:storefront": "npm run build --prefix apps/storefront",
    "build:masterpanel": "npm run build --prefix apps/masterpanel",
    "build:orderops": "npm run build --prefix apps/orderops",
    "build:explore": "npm run build --prefix apps/explore",
    "build": "npm run build:brandhome && npm run build:storefront && npm run build:masterpanel && npm run build:orderops && npm run build:explore"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
